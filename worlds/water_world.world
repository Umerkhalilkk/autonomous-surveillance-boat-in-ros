<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="water_box">
      <static>true</static>
      <pose>0 0 -0.5 0 0 0</pose> 
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 20 1.0</size> 
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.4 0.8 0.8</ambient> 
            <diffuse>0.1 0.4 0.8 0.8</diffuse> 
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0 0 0 0</emissive>
          </material>
        </visual>
      </link>
    </model>
    
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

  </world>
</sdf>
