<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="floating_block">
    <static>false</static>

    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>

      <inertial>
        <mass>7.8125</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.25 0.25 0.25</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.25 0.25 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin name="buoyancy_plugin" filename="libbuoyancy_plugin.so">
  <link_name>link</link_name>
  <water_level>10.0</water_level>   <!-- IMPORTANT: top of 20x20x10 water box -->
  <fluid_density>1000</fluid_density>
  <linear_damping>1.2</linear_damping>
  <angular_damping>1.2</angular_damping>
   </plugin>


  </model>
</sdf>

